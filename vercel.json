{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "api.mjs", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api", "dest": "/api.mjs" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
